# All values are EXAMPLES: supply real values locally, never commit secrets.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=candidate_profile
QDRANT_VECTOR_SIZE=768
RAG_TOP_K=8
MATCH_THRESHOLD=70
STATE_DB=data/history.sqlite3
CHECKPOINT_DB=data/checkpoints.sqlite3
RETRIEVAL_CONTEXT_LIMIT=15000
# MCP fetch server must be installed separately. Example: uvx mcp-server-fetch
MCP_FETCH_COMMAND=.venv/bin/python
MCP_FETCH_ARGS=["-m", "mcp_server_fetch"]
MCP_FETCH_TIMEOUT=25
MCP_FETCH_MAX_CHARS=14000
# Start with explicit allowed hosts if external URLs required, comma separated:
MCP_FETCH_ALLOWED_DOMAINS=
INGEST_HOST=127.0.0.1
INGEST_PORT=8000
INGEST_API_KEY=
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_reader
TG_ALLOWED_CHAT_IDS=
# JSON mapping, example {"-1001234567890":[10,20]}
TG_ALLOWED_TOPICS={}
TG_BOT_TOKEN=
TG_TARGET_CHAT_ID=
TELETHON_INGEST_URL=http://127.0.0.1:8000/vacancies/ingest
MAX_STARTUP_UNREAD_PER_SOURCE=0
STARTUP_SEND_DELAY_SECONDS=0.15
